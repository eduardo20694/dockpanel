# Copie para .env e preencha localmente (nunca commite .env)

# Hosts Docker — JSON array: [{ "id", "label", "dockerHost" }]
# dockerHost vazio = socket local; ssh://user@host = remoto
DOCKPANEL_HOSTS=[{"id":"vps","label":"VPS","dockerHost":"ssh://user@SEU_IP"}]

# Fallback se DOCKPANEL_HOSTS não estiver definido
# DOCKER_HOST=unix:///var/run/docker.sock

PORT=8080
DOCKPANEL_DATA_DIR=data
DOCKPANEL_BACKUP_DIR=
DOCKPANEL_COMPOSE_PATH=

# Autenticação (PostgreSQL)
# Opção A — URL completa (backend na VPS, Postgres no mesmo servidor):
# DATABASE_URL=postgres://dockpanel:SENHA_DOCKPANEL@127.0.0.1:5432/dockpanel?sslmode=disable
#
# Opção B — variáveis separadas (docker compose na VPS):
# POSTGRES_HOST=host.docker.internal
# POSTGRES_PORT=5432
# POSTGRES_USER=dockpanel
# POSTGRES_PASSWORD=SENHA_DOCKPANEL
# POSTGRES_DB=dockpanel
# POSTGRES_SSLMODE=disable
#
# Dev no PC + Postgres na VPS (túnel SSH antes: ssh -L 5433:127.0.0.1:5432 root@SEU_IP):
# Prefira POSTGRES_* se a senha tiver @, #, etc. (DATABASE_URL quebra com esses chars)
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5433
# POSTGRES_USER=dockpanel
# POSTGRES_PASSWORD=sua-senha
# POSTGRES_DB=dockpanel
# POSTGRES_SSLMODE=disable
#
# Ou URL (senha URL-encoded: @ → %40):
# DATABASE_URL=postgres://dockpanel:SENHA@127.0.0.1:5433/dockpanel?sslmode=disable
# DOCKPANEL_JWT_SECRET=gerar-string-longa-aleatoria-min-32-chars
# Primeiro admin (criado automaticamente se users estiver vazia):
# DOCKPANEL_ADMIN_EMAIL=admin@empresa.com
# DOCKPANEL_ADMIN_PASSWORD=senha-forte-login-painel
# DOCKPANEL_ADMIN_NAME=Administrador

# Alertas (opcional)
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=
# ALERT_DISCORD_WEBHOOK=
