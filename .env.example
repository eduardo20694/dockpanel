# Copie para .env e preencha localmente (nunca commite .env)

# Hosts Docker — JSON array: [{ "id", "label", "dockerHost" }]
# dockerHost vazio = socket local; ssh://user@host = remoto
DOCKPANEL_HOSTS=[{"id":"vps","label":"VPS","dockerHost":"ssh://user@SEU_IP"}]

# Fallback se DOCKPANEL_HOSTS não estiver definido
# DOCKER_HOST=unix:///var/run/docker.sock

PORT=8080
DOCKPANEL_DATA_DIR=data
DOCKPANEL_BACKUP_DIR=
DOCKPANEL_COMPOSE_PATH=

# Alertas (opcional)
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=
# ALERT_DISCORD_WEBHOOK=
