# Dev local. Em produção prefira DOCKERPILOT_*.
# Se a variável nova estiver vazia, DOCKPANEL_* ainda é lida.

PORT=8080
DOCKERPILOT_DATA_DIR=./data

DOCKERPILOT_ADMIN_EMAIL=admin@localhost
DOCKERPILOT_ADMIN_PASSWORD=troque-esta-senha
DOCKERPILOT_ADMIN_NAME=Administrador
DOCKERPILOT_JWT_SECRET=troque-este-segredo-em-producao-min-32

# kind vazio ou "auto" deixa o Dockpilot detectar Docker, Podman, Swarm manager/worker.
# kind explícito (docker, swarm, kubernetes, podman) permanece e a detecção aparece ao lado.
DOCKERPILOT_HOSTS=[{"id":"local","label":"Local","dockerHost":""}]
# DOCKERPILOT_KUBECONFIG=~/.kube/config
# DOCKERPILOT_K8S_INCLUSTER=1
# DOCKERPILOT_COMPOSE_PATH=
# DOCKERPILOT_READONLY=0
# DOCKERPILOT_LOG_RETENTION_DAYS=60

# SSO (opcional). HMAC é o verificador embutido para o gateway da organização.
# DOCKERPILOT_OIDC_ISSUER=https://login.example.com
# DOCKERPILOT_OIDC_CLIENT_ID=dockpilot
# DOCKERPILOT_OIDC_HMAC_SECRET=
# DOCKERPILOT_OIDC_ADMIN_GROUP=dockpilot-admins
# DOCKERPILOT_OIDC_OPERATOR_GROUP=dockpilot-operators

# Kubernetes, só se houver cluster
# DOCKERPILOT_K8S_API=https://kubernetes.default.svc
# DOCKERPILOT_K8S_TOKEN=

# Estimativa de custo (USD por hora)
# DOCKERPILOT_CPU_USD_HOUR=0.04
# DOCKERPILOT_MEM_GB_USD_HOUR=0.005

# Alertas
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=
# ALERT_DAILY_HOUR=9
# TZ=America/Sao_Paulo
# ALERT_DISCORD_WEBHOOK=

# Cofre (AES-GCM). 32 bytes em base64/hex, ou uma frase (vira SHA-256).
# DOCKERPILOT_SECRETS_KEY=

# Registry privado para checar imagens novas
# DOCKERPILOT_REGISTRY_USER=
# DOCKERPILOT_REGISTRY_PASSWORD=
# DOCKERPILOT_REGISTRY_TOKEN=

# MCP remoto
# DOCKERPILOT_MCP_ADDR=:8090
# DOCKERPILOT_MCP_RATE_PER_MIN=120
