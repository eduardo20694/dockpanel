# Variáveis para produção (Portainer / VPS)
# Cole na stack do Portainer em "Environment variables" — não use env_file no Portainer

VERSION=0.0.1

DOCKPANEL_HOSTS=[{"id":"vps","label":"VPS","dockerHost":""}]
PORT=8080
DOCKPANEL_DATA_DIR=/data

# Postgres no host — container acessa via host.docker.internal
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=dockpanel
POSTGRES_PASSWORD=TROQUE_SENHA
POSTGRES_DB=dockpanel
POSTGRES_SSLMODE=disable

DOCKPANEL_JWT_SECRET=TROQUE_JWT_SECRET_LONGO_MIN_32_CHARS

# Primeiro admin (só se a tabela users estiver vazia)
# DOCKPANEL_ADMIN_EMAIL=admin@empresa.com
# DOCKPANEL_ADMIN_PASSWORD=senha-forte
# DOCKPANEL_ADMIN_NAME=Administrador

# Alertas (opcional)
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=
# ALERT_DISCORD_WEBHOOK=
