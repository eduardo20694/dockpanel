# Modelo para Portainer — copie, preencha e cole em Environment / .env da stack.
# Segredos ficam SÓ aqui (ou no Portainer). O docker-compose.yml não traz senha/JWT.

DOCKPANEL_ADMIN_EMAIL=
DOCKPANEL_ADMIN_PASSWORD=
DOCKPANEL_ADMIN_NAME=
DOCKPANEL_JWT_SECRET=

DOCKPANEL_HOSTS=[{"id":"local","label":"Docker","dockerHost":""}]

DOCKPANEL_PROJECT_DIR=.
DOCKPANEL_COMPOSE_PATH=/opt/dockpanel
DOCKPANEL_BACKUP_DIR=/data/backups

# Opcional — notificações externas (histórico local funciona sem isso)
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=
# ALERT_DISCORD_WEBHOOK=
