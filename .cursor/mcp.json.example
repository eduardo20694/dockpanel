{
  "mcpServers": {
    "dockpilot": {
      "command": "dockerpilot-mcp",
      "env": {
        "DOCKERPILOT_HOSTS": "[{\"id\":\"vps\",\"label\":\"VPS\",\"dockerHost\":\"ssh://root@SEU_IP\"}]",
        "DOCKERPILOT_COMPOSE_PATH": "/opt/dockpilot",
        "DOCKERPILOT_COMPOSE_PATH_REMOTE": "/opt/dockpilot",
        "DOCKERPILOT_READONLY": "0"
      }
    }
  }
}
